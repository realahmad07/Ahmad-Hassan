<section class="custom-banner" id="shopify-section-{{ section.id }}">
  <div class="banner-media" aria-hidden="true">
    {%- if section.settings.background_image != blank -%}
      <img src="{{ section.settings.background_image | image_url: width: 2000 }}" alt="" loading="eager">
    {%- else -%}
      <div class="banner-placeholder"></div>
    {%- endif -%}
    <div class="banner-overlay"></div>
  </div>

  <div class="banner-container">
    <div class="banner-content">
      <span class="banner-subtitle">{{ section.settings.subtitle }}</span>
      <h1 class="banner-heading">{{ section.settings.heading }}</h1>
      <p class="banner-description">{{ section.settings.description }}</p>

      {%- if section.settings.button_text != blank -%}
        <a href="{{ section.settings.button_link }}" class="banner-btn">
          {{ section.settings.button_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .custom-banner {
    position: relative;
    min-height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: {{ section.settings.bg_color }};
  }

  .banner-media,
  .banner-media img,
  .banner-placeholder,
  .banner-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .banner-media img,
  .banner-placeholder {
    object-fit: cover;
    display: block;
  }

  .banner-placeholder {
    background: linear-gradient(135deg, #8ba7a8 0%, #b6a4a0 45%, #8d9782 100%);
  }

  .banner-overlay {
    background: linear-gradient(180deg, rgba(0,0,0,0.1), rgba(0,0,0,0.28));
  }

  .banner-container {
    position: relative;
    z-index: 1;
    width: min(1200px, 100%);
    margin: 0 auto;
    padding: 0 20px;
  }

  .banner-content {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    color: #fff;
  }

  .banner-subtitle {
    display: block;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin-bottom: 18px;
    color: rgba(255,255,255,0.9);
    font-weight: 600;
  }

  .banner-heading {
    font-size: clamp(32px, 4vw, 54px);
    font-weight: 700;
    line-height: 1.08;
    margin: 0 0 18px;
    color: #fff;
  }

  .banner-description {
    font-size: 16px;
    line-height: 1.5;
    margin: 0 auto 26px;
    color: rgba(255,255,255,0.9);
    max-width: 540px;
  }

  .banner-btn {
    display: inline-block;
    background-color: rgba(255,255,255,0.12);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.4);
    padding: 12px 22px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.3s ease, background-color 0.3s ease, box-shadow 0.3s ease;
    backdrop-filter: blur(2px);
  }

  .banner-btn:hover {
    background-color: rgba(255,255,255,0.18);
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
  }

  @media screen and (max-width: 768px) {
    .custom-banner {
      min-height: 420px;
    }

    .banner-content {
      max-width: 500px;
    }

    .banner-description {
      margin-bottom: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5F5F5"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE GIFT GUIDE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Browse our latest products"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Shop the latest essentials curated for a comfortable, elevated everyday look."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}
