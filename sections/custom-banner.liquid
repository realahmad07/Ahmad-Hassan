<section class="custom-banner" id="shopify-section-{{ section.id }}">
  <div class="banner-container">
    <div class="banner-content">
      <span class="banner-subtitle">{{ section.settings.subtitle }}</span>
      <h1 class="banner-heading">{{ section.settings.heading }}</h1>
      <p class="banner-description">{{ section.settings.description }}</p>
      
      {%- if section.settings.button_text != blank -%}
        <a href="{{ section.settings.button_link }}" class="banner-btn">
          {{ section.settings.button_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .custom-banner {
    position: relative;
    background-color: {{ section.settings.bg_color }};
    padding: 60px 20px;
    text-align: left;
  }

  .banner-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .banner-subtitle {
    display: block;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 10px;
    color: #666;
  }

  .banner-heading {
    font-size: 48px;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 20px;
    color: #111;
  }

  .banner-description {
    font-size: 16px;
    line-height: 1.5;
    margin-bottom: 30px;
    color: #444;
    max-width: 500px;
  }

  /* Button and required animation styling */
  .banner-btn {
    display: inline-block;
    background-color: #000;
    color: #fff;
    padding: 14px 32px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.3s ease, background-color 0.3s ease, box-shadow 0.3s ease;
  }

  .banner-btn:hover {
    background-color: #333;
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
  }

  /* Mobile view responsiveness */
  @media screen and (max-width: 768px) {
    .custom-banner {
      padding: 40px 16px;
      text-align: center;
    }
    .banner-heading {
      font-size: 32px;
    }
    .banner-description {
      margin: 0 auto 24px auto;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F5F5F5"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE GIFT GUIDE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover joy: Your Ultimate Holiday Gift Destination."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Explore our curated selection and find the perfect gift to delight your loved ones."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner"
    }
  ]
}
{% endschema %}
