<section class="custom-product-grid-section" id="shopify-section-{{ section.id }}">
  <div class="product-grid-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="grid-section-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="product-grid">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        
        <div class="product-grid-item" {{ block.shopify_attributes }}>
          {%- if product != blank -%}
            <div class="product-card">
              <a href="{{ product.url }}" class="product-link">
                <div class="product-image-wrapper">
                  {%- if product.featured_image != blank -%}
                    <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" class="product-img">
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="product-info">
                  <h3 class="product-title">{{ product.title }}</h3>
                  <span class="product-price">{{ product.price | money }}</span>
                </div>
              </a>

              <script type="application/json" class="product-json">
                {
                  "id": {{ product.id }},
                  "title": {{ product.title | json }},
                  "price": {{ product.price | money | json }},
                  "description": {{ product.description | json }},
                  "url": {{ product.url | json }},
                  "variants": [
                    {%- for variant in product.variants -%}
                      {
                        "id": {{ variant.id }},
                        "title": {{ variant.title | json }},
                        "available": {{ variant.available }},
                        "price": {{ variant.price | money | json }}
                      }{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  ]
                }
              </script>
              
              <button type="button" class="quick-view-btn" data-product-id="{{ product.id }}">Quick View</button>
            </div>
          {%- else -%}
            <div class="product-card placeholder-card">
              <div class="product-image-wrapper">
                {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
              <div class="product-info">
                <h3 class="product-title">Example Product Title</h3>
                <span class="product-price">$19.99</span>
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .custom-product-grid-section {
    padding: 60px 20px;
    background-color: #fff;
  }
  .product-grid-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .grid-section-heading {
    text-align: center;
    font-size: 32px;
    margin-bottom: 40px;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }
  .product-card {
    background: #f9f9f9;
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }
  .product-card:hover {
    transform: translateY(-5px);
  }
  .product-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .product-image-wrapper {
    width: 100%;
    height: 300px;
    overflow: hidden;
    background: #eee;
  }
  .product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-info {
    padding: 15px;
  }
  .product-title {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .product-price {
    font-size: 15px;
    color: #333;
    font-weight: 500;
  }
  .quick-view-btn {
    display: block;
    width: calc(100% - 30px);
    margin: 0 15px 15px 15px;
    padding: 10px;
    background: #000;
    color: #fff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 600;
  }
  .quick-view-btn:hover {
    background: #333;
  }

  @media screen and (max-width: 900px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }
  @media screen and (max-width: 600px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Featured Products"
    }
  ],
  "blocks": [
    {
      "type": "product_block",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid",
      "blocks": [
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" },
        { "type": "product_block" }
      ]
    }
  ]
}
{% endschema %}
